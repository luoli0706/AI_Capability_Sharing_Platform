MYSQL_ROOT_PASSWORD=ascp123456
MYSQL_USER=root
MYSQL_DATABASE=ascp
JWT_SECRET=change-me-in-production-ascp-jwt-secret

# Docker resource limits (auto-calculated by scripts/configure_docker_limits.sh)
# Strategy: 80% host RAM total mem_reservation (soft smoothing) / 90% host RAM total mem_limit (hard OOM cap)
# Ratio: MySQL 40%, Backend 45%, Frontend 15%
MYSQL_MEM_RESERVATION=640m
MYSQL_MEM_LIMIT=720m
MYSQL_CPUS=1.0
BACKEND_MEM_RESERVATION=720m
BACKEND_MEM_LIMIT=810m
BACKEND_CPUS=1.0
FRONTEND_MEM_RESERVATION=240m
FRONTEND_MEM_LIMIT=270m
FRONTEND_CPUS=0.5
