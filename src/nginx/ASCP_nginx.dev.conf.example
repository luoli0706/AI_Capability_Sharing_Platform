# ASCP Nginx 本地开发环境配置模板
# 适用场景：本地 Docker 容器 (nginx-local) 监听 80/443，将前端请求代理到宿主机 Vite (5173)，后端 API 代理到宿主机 Go Echo (8080)

limit_req_zone $binary_remote_addr zone=ascp_auth_limit:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=ascp_invoke_limit:10m rate=50r/s;

upstream ascp_dev_frontend {
    server host.docker.internal:5173;
}

upstream ascp_dev_backend {
    server host.docker.internal:8080;
}

server {
    listen 80;
    server_name localhost;

    client_max_body_size 50m;

    # 前端 Vite 开发服务器反向代理（支持 WebSocket HMR 热更新）
    location / {
        proxy_pass http://ascp_dev_frontend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 认证接口限流与反向代理
    location /api/v1/auth/ {
        limit_req zone=ascp_auth_limit burst=30 nodelay;
        proxy_pass http://ascp_dev_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 能力代理调用接口（支持 SSE 流式输出 + 限流）
    location /api/v1/invoke/ {
        limit_req zone=ascp_invoke_limit burst=80 nodelay;
        proxy_pass http://ascp_dev_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # 通用后端 API 反向代理
    location /api/ {
        proxy_pass http://ascp_dev_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
